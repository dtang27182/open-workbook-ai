{
  "schemaVersion": 13,
  "stage": "high-level-design",
  "userFlows": [
    {
      "name": "Select a model and submit a request",
      "steps": [
        {
          "id": 1,
          "text": "The user opens the task pane."
        },
        {
          "id": 2,
          "text": "The task pane displays the model dropdown with the default selection."
        },
        {
          "id": 3,
          "text": "The user selects a model from the visible task-pane dropdown."
        },
        {
          "id": 4,
          "text": "The system retains the selected model configuration for this task-pane instance."
        },
        {
          "id": 5,
          "text": "The dropdown displays the selected model."
        },
        {
          "id": 6,
          "text": "The user enters text in the chat input."
        },
        {
          "id": 7,
          "text": "The user submits the chat input."
        },
        {
          "id": 8,
          "text": "The existing chat workflow supplies the main-model request inputs."
        },
        {
          "id": 9,
          "text": "For each subsequent in-scope request, the system reads the current selected model configuration."
        },
        {
          "id": 10,
          "text": "The system sends the request to OpenRouter using that configuration."
        }
      ]
    }
  ],
